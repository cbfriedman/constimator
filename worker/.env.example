# Same Supabase Postgres connection string as the main app's DATABASE_URL
# (direct connection, not the pooled one — see the main app's step-6 notes).
# This worker needs the same privileged access lib/db/client.ts has, since
# it services every org's queued jobs, not one caller's.
DATABASE_URL=

# How often to poll for queued jobs, in milliseconds. Defaults to 5000.
POLL_INTERVAL_MS=

# Required (step 16) — real extraction downloads the document from Storage
# and calls Claude. Use the service role key, not the anon key: this worker
# has no per-user session (see download-document.ts).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# Optional — defaults to claude-sonnet-5. See src/extract.ts.
TAKEOFF_MODEL=

# Optional (step 25) — same Upstash database as the main app's
# UPSTASH_REDIS_REST_URL/TOKEN (must be the same one: this worker's
# call-time rate-limit check and the app's queue-time check share one
# counter per org). Without it, rate limiting logs a warning and no-ops —
# the monthly spend cap (src/ai-limits.ts) still applies regardless, it
# only needs DATABASE_URL.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional (step 29) — same Sentry project as the main app's SENTRY_DSN
# (can be a different DSN if you want worker errors in a separate Sentry
# project; either works, src/sentry.ts doesn't assume which). Without it,
# error tracking no-ops; structured JSON logging to stdout (src/logger.ts)
# still happens regardless.
SENTRY_DSN=
