{
  // Typecheck-only config covering the test files that tsconfig.json leaves
  // out of the build. Vitest runs tests through esbuild, which strips types
  // without checking them, so without this a test file's types are never
  // verified by anything.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": []
}
