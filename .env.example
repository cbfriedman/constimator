# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Database (Project Settings → Database → Connection string, URI)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Optional
# MAINTENANCE_MODE=false

# Upstash Redis (console.upstash.com → your database → REST API). Used for
# takeoff request rate limiting (lib/ai-limits.ts, step 25). Not required —
# rate limiting just logs a warning and no-ops without it (the monthly
# spend cap still works either way, it only needs the database).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
