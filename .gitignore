# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# editor-local config that has historically carried credentials.
# .vscode/sftp.json held a plaintext production SFTP password in git
# history — keep deploy credentials out of the repo entirely.
.vscode/sftp.json
.vscode/*.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts
.vercel
