# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Database — use the Session pooler URI from Supabase:
# Project Settings → Database → Connect → Session mode (port 5432)
# Do NOT use db.PROJECT_REF.supabase.co if DNS fails (common without IPv4 add-on).
# URL-encode special characters in the password (e.g. ! → %21).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Optional
# MAINTENANCE_MODE=false

# Upstash Redis (console.upstash.com → your database → REST API). Used for
# takeoff request rate limiting (lib/ai-limits.ts, step 25). Not required —
# rate limiting just logs a warning and no-ops without it (the monthly
# spend cap still works either way, it only needs the database).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Sentry (sentry.io → your project → Settings → Client Keys (DSN)). Step 29.
# Not required — every Sentry.init() in this app is enabled: !!dsn, so
# error tracking just no-ops without it. SENTRY_DSN is used server-side
# (sentry.server.config.ts, sentry.edge.config.ts); NEXT_PUBLIC_SENTRY_DSN
# is the same DSN value but ships in the browser bundle for the client side
# (instrumentation-client.ts) — DSNs are write-only ingest endpoints, not
# secret, so reusing the same value for both is fine.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# Optional — only needed for source map upload at build time (better
# stack traces in Sentry). Without SENTRY_AUTH_TOKEN, the build just skips
# that step; error tracking itself doesn't need it.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Shared secret for /api/health (step 29 — the uptime-check target for the
# Railway worker and its takeoff_job queue, see that route for detail).
# Optional but recommended in production — without it, the endpoint is
# open to anyone who finds the URL (it only ever returns aggregate
# counts, never per-org data, but it's still needless DB load to expose
# publicly). Point your uptime monitor at /api/health?token=<this value>.
# HEALTH_CHECK_TOKEN=
