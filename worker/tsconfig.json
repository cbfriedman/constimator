{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  // Tests are typechecked and run by vitest, not compiled into dist/ — the
  // deployed worker has no reason to ship them.
  "exclude": ["src/**/*.test.ts"]
}
