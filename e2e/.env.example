# The e2e suite creates its own throwaway, pre-confirmed user for each run
# via the Supabase Admin API (e2e/global-setup.ts) instead of signing up
# through the UI — avoids depending on email confirmation. That needs the
# service role key, which the app itself never uses client-side, so it's
# kept out of the root .env.local on purpose.
#
# Supabase Project Settings → API → service_role key (secret).
SUPABASE_SERVICE_ROLE_KEY=

# Optional — point the suite at a different running instance instead of
# letting Playwright start `next dev` itself.
# E2E_BASE_URL=http://localhost:3000
